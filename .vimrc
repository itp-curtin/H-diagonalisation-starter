
"allow vim to do stuff based on file type
filetype plugin on 
filetype indent plugin on

"Show matching bracket when the cursor is over a bracket
set showmatch

"Turn on auto indenting
set autoindent

"Make <TAB> insert spaces
set expandtab
set shiftwidth=2
set softtabstop=2

"Ignore case in searches, unless the search pattern has upper-case letters:
set ignorecase
set smartcase

"Highlight what you are searching as you type
set incsearch

"Enable the mouse
set mouse=a

"Don't wrap lines
set nowrap

"Enable line numbers
set number

"Display line/column number in status bar
set ruler

"Enable syntax highlighting
syntax enable
